# Canonical deployment origin (used for metadataBase / share URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: show the local Agentation feedback overlay during development.
NEXT_PUBLIC_AGENTATION_ENABLED=false

# Public analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_DEBUG=

# Token Radar's only required data configuration. Keep the key server-side.
# API_BASE_URL takes precedence over TOKENS_API_ORIGIN when set.
API_BASE_URL=https://api.tokens.xyz
TOKENS_API_ORIGIN=
TOKENS_PLATFORM_API_KEY=

# API status page history from read-only Loki query credentials
TOKENS_STATUS_LOKI_URL=
TOKENS_STATUS_LOKI_USER=
TOKENS_STATUS_LOKI_TOKEN=
TOKENS_STATUS_LOKI_TARGET=prod
TOKENS_STATUS_LOKI_ENV=prd

# Optional additional hosts for remote image/dominant-color fetching
TOKENS_IMAGE_PROXY_ALLOWED_HOSTS=

# Server-side provider credentials used by web routes
BIRDEYE_API_KEY=
COINGECKO_API_KEY=
DD_API_KEY=
