# Clerk auth for the admin app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated origins allowed to carry Clerk sessions (e.g. https://admin.tokens.xyz)
CLERK_AUTHORIZED_PARTIES=

# Clerk sign-in routing (prebuilt <SignIn> page served by this app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/curation

# Cloud Run services backing the /api/admin proxy
TOKENS_CLOUDRUN_ADMIN_URL=
TOKENS_CLOUDRUN_ASSETS_URL=

# Vercel OIDC → GCP Workload Identity Federation (deployed environments).
# GCP_WIF_AUDIENCE is the //iam.googleapis.com/... provider path (terraform
# output vercel_wif_audience); GCP_ADMIN_INVOKER_SA is the invoker service
# account email (terraform output vercel_admin_invoker_sa_email). When both
# are set the app mints a Google ID token per request instead of using the
# shared bearer below.
GCP_WIF_AUDIENCE=
GCP_ADMIN_INVOKER_SA=

# Legacy shared bearer — local dev fallback only. Do NOT set on the deployed
# Vercel project; admin→Cloud Run auth uses the OIDC id-token there.
TOKENS_CLOUDRUN_AUTH_TOKEN=

# Comma-separated Clerk user IDs allowed to operate admin tooling
TOKENS_ADMIN_CLERK_USER_IDS=
# Comma-separated verified-email allowlist (case-insensitive); unioned with the
# user-ID list above. Emails must be verified on the Clerk account to count.
TOKENS_ADMIN_EMAILS=
